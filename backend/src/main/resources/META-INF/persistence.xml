<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

  <persistence-unit name="jyaaPU" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

    <!-- Sin listar <class>: Hibernate/JPA detecta @Entity en el classpath (evita falsos errores del IDE) -->
    <exclude-unlisted-classes>false</exclude-unlisted-classes>

    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
      <property name="jakarta.persistence.jdbc.url"
                value="jdbc:mysql://mysql.java.linti.unlp.edu.ar:3306/jyaa2026_bd1?useSSL=false&amp;serverTimezone=UTC&amp;connectTimeout=10000&amp;socketTimeout=60000"/>
      <property name="jakarta.persistence.jdbc.user" value="jyaa2026_usr1"/>
      <property name="jakarta.persistence.jdbc.password" value="jyaa2026_pwd1"/>
      <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
      <property name="hibernate.hbm2ddl.auto" value="update"/>
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.format_sql" value="true"/>
    </properties>
  </persistence-unit>
</persistence>
